# Template file for 'asusctl'
pkgname=asusctl
version=6.5.0.20261116
revision=12
# Seven local patches (Aura sleep handler, asusd-user runtime, runtime state on
# sleep, per-key guard, brightness at startup, duplicate logind signals,
# scalable SVG tray icons) are documented in PATCHES.md, including how to check
# whether a newer upstream commit makes them unnecessary.
_commit=5346e184d09c5ed46e5dd16cdecedb7608393502
# Files are installed manually in do_install because upstream's "make install"
# ships systemd units we do not want on a runit-based system.
hostmakedepends="pkg-config rust cargo clang cmake gettext git"
makedepends="eudev-libudev-devel dbus-devel pcre2-devel libxkbcommon-devel
 libzstd-devel gtk+3-devel"
depends="dbus eudev"
# bindgen-backed Cargo tests need libclang/llvm-config; the workspace
# simulator tests also link against SDL2.
checkdepends="clang21-devel SDL2-devel"
short_desc="Daemon, CLI and control center for ASUS ROG laptops"
maintainer="Khame <khame.dev@protonmail.com>"
# License of the asusctl sources. rog-control-center also links Slint (offered
# upstream as GPL-3.0-only OR Slint Royalty-free OR Slint Software); that
# choice belongs to upstream, see LICENSES.md. Own files are MIT, and the
# asusctl-plasma subpackage below carries its own license text.
license="MPL-2.0"
homepage="https://github.com/OpenGamingCollective/asusctl"
# Latest main-branch commit: aura support for the ROG Strix G18 G814FP; no
# upstream release tag for the 6.5.0 series. The snapshot also carries the
# pulldown-cmark security bump, three rog-control-center layout fixes and
# Aura support for several new models.
distfiles="https://github.com/OpenGamingCollective/asusctl/archive/${_commit}.tar.gz"
checksum=a7dda0b46c3af5f9e319b62c540af0b75ce2caaf8a54232b7745ee1e611b9688

do_build() {
	# The upstream Makefile's default target is just this Cargo command. Avoid
	# its unrelated grep -P version probe, which Void's grep does not support.
	cargo build --release --locked
}

do_check() {
	cargo test --workspace --locked
}

do_install() {
	# ── binaries ──
	# asus-shutdown is skipped: it waits for logind's PrepareForShutdown and
	# calls systemctl, so under runit it would never do its job.
	vbin target/release/asusd
	vbin target/release/asusctl
	vbin target/release/asusd-user
	vbin target/release/rog-control-center

	# ── icons ──
	# rog-control-center installs notification icons and GPU mode icons
	if [ -f data/icons/asus_notif_yellow.png ]; then
		vmkdir usr/share/icons/hicolor/512x512/apps
		vcopy data/icons/*.png usr/share/icons/hicolor/512x512/apps/
	fi
	if [ -f data/icons/scalable/gpu-compute.svg ]; then
		vmkdir usr/share/icons/hicolor/scalable/status
		vcopy data/icons/scalable/* usr/share/icons/hicolor/scalable/status/
	fi
	# Tray icons: scalable SVGs the tray references by name (IconName), so the
	# panel renders them at its own size instead of scaling a 512 px bitmap.
	# They come from files/ because the patch changes code, not assets.
	vinstall ${FILESDIR}/icons/rog-tray-blue.svg 644 usr/share/icons/hicolor/scalable/status
	vinstall ${FILESDIR}/icons/rog-tray-red.svg 644 usr/share/icons/hicolor/scalable/status
	vinstall ${FILESDIR}/icons/rog-tray-white.svg 644 usr/share/icons/hicolor/scalable/status
	# ── udev ──
	# data/asusd.rules is not installed: it only sets TAG+="systemd" and
	# ENV{SYSTEMD_WANTS}+="asusd.service asus-shutdown.service".
	# eudev ignores those entries, and asusd is started by runit instead.

	# ── rog-control-center desktop integration ──
	if [ -f rog-control-center/data/org.opengamingcollective.rog-control-center.desktop ]; then
		vinstall rog-control-center/data/org.opengamingcollective.rog-control-center.desktop 644 usr/share/applications
	fi
	if [ -f rog-control-center/data/org.opengamingcollective.rog-control-center.metainfo.xml ]; then
		vinstall rog-control-center/data/org.opengamingcollective.rog-control-center.metainfo.xml 644 usr/share/metainfo
	fi
	if [ -f rog-control-center/data/rog-control-center.png ]; then
		vmkdir usr/share/icons/hicolor/512x512/apps
		vinstall rog-control-center/data/rog-control-center.png 644 usr/share/icons/hicolor/512x512/apps
	fi

	# ── D-Bus policy (independent of the init system) ──
	vinstall data/asusd.conf 644 usr/share/dbus-1/system.d

	# ── Aura support data and keyboard layouts ──
	# Upstream looks for the LED support database at
	# /usr/share/asusd/aura_support.ron and for keyboard layouts at
	# /usr/share/rog-gui/layouts/ (asusd-user, direct addressing). Without
	# the files asusd falls back to the embedded copy, but asusd-user fails
	# to find a layout for the detected model.
	vmkdir usr/share/asusd
	vinstall rog-aura/data/aura_support.ron 644 usr/share/asusd
	if [ -d rog-aura/data/layouts ]; then
		vcopy rog-aura/data/layouts/* usr/share/asusd/
		vmkdir usr/share/rog-gui/layouts
		vcopy rog-aura/data/layouts/* usr/share/rog-gui/layouts/
	fi

	# ── runit service instead of systemd units ──
	vinstall ${FILESDIR}/asusd/run 755 etc/sv/asusd
	vinstall ${FILESDIR}/asusd-log/run 755 etc/sv/asusd/log

	# ── XDG autostart instead of "systemd --user" ──
	vinstall ${FILESDIR}/xdg-autostart/asusd-user.desktop 644 etc/xdg/autostart
	vbin ${FILESDIR}/asusd-user-session

	# ── KDE plasmoid (profile / charge limit / keyboard / Aura widget) ──
	# System-wide install instead of ~/.local/share, so it is visible to
	# every user without manual copying; runtime requirements are listed in
	# INSTALL.msg (xbps-src has no optdepends).
	vmkdir usr/share/plasma/plasmoids/org.voidlinux.plasma.asusctl
	vcopy ${FILESDIR}/plasmoid/org.voidlinux.plasma.asusctl/* \
		usr/share/plasma/plasmoids/org.voidlinux.plasma.asusctl/

	vlicense LICENSE
}

asusctl-plasma_package() {
	short_desc="KDE Plasma widget for ASUS ROG laptops"
	depends="${sourcepkg}>=${version}_${revision} plasma-workspace kf6-kirigami
	 plasma5support"
	# The widget is own work, not part of upstream asusctl.
	license="MIT"

	pkg_install() {
		vmove usr/share/plasma/plasmoids/org.voidlinux.plasma.asusctl
		vlicense ${FILESDIR}/plasmoid/LICENSE
	}
}
