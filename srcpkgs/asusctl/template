# Template file for 'asusctl'
pkgname=asusctl
version=6.5.0.20261024
revision=1
_commit=13cdaa9ccbc0b519d3c888c1c9d97e00faf91cf9
build_style=gnu-makefile
make_build_target="all"
# Instalujemy ręcznie w do_install, bo upstreamowy "make install" wrzuca
# jednostki systemd, których tu nie chcemy.
hostmakedepends="pkg-config rust cargo clang cmake gettext git"
makedepends="eudev-libudev-devel dbus-devel pcre2-devel libxkbcommon-devel
 libzstd-devel gtk+3-devel"
depends="dbus eudev"
short_desc="Daemon, CLI and KDE Plasma widget for ASUS ROG laptops"
maintainer="Khame <lukasz.linhard@gmail.com>"
license="MPL-2.0"
homepage="https://github.com/OpenGamingCollective/asusctl"
# Latest main-branch commit: per-key LED support for G713PI, TUF A16 FA608WV
# support, TUF kbd_rgb_mode speed fix. There is no upstream release tag for it.
distfiles="https://github.com/OpenGamingCollective/asusctl/archive/${_commit}.tar.gz"
checksum=b202bb4ba0dfeb4ec46975ad69d9e39bec54441e9af833adfc0e24f32ead8a35

do_install() {
	# ── binarki ──
	# asus-shutdown pomijamy: czeka na PrepareForShutdown z logind i woła
	# systemctl, więc pod runit nigdy nie wykona swojej pracy.
	vbin target/release/asusd
	vbin target/release/asusctl
	vbin target/release/asusd-user
	vbin target/release/rog-control-center

	# ── ikony ──
	# rog-control-center installs notification icons and GPU mode icons
	if [ -f data/icons/asus_notif_yellow.png ]; then
		vmkdir usr/share/icons/hicolor/512x512/apps
		vcopy data/icons/*.png usr/share/icons/hicolor/512x512/apps/
	fi
	if [ -f data/icons/scalable/gpu-compute.svg ]; then
		vmkdir usr/share/icons/hicolor/scalable/status
		vcopy data/icons/scalable/* usr/share/icons/hicolor/scalable/status/
	fi
	# ── udev ──
	# data/asusd.rules nie jest instalowany: zawiera wyłącznie
	# TAG+="systemd" i ENV{SYSTEMD_WANTS}="asusd.service
	# asus-shutdown.service". eudev te wpisy ignoruje, a asusd startuje
	# z runit.

	# ── rog-control-center desktop integration ──
	if [ -f rog-control-center/data/org.opengamingcollective.rog-control-center.desktop ]; then
		vinstall rog-control-center/data/org.opengamingcollective.rog-control-center.desktop 644 usr/share/applications
	fi
	if [ -f rog-control-center/data/org.opengamingcollective.rog-control-center.metainfo.xml ]; then
		vinstall rog-control-center/data/org.opengamingcollective.rog-control-center.metainfo.xml 644 usr/share/metainfo
	fi
	if [ -f rog-control-center/data/rog-control-center.png ]; then
		vmkdir usr/share/icons/hicolor/512x512/apps
		vinstall rog-control-center/data/rog-control-center.png 644 usr/share/icons/hicolor/512x512/apps
	fi

	# ── dbus policy (działa niezależnie od initu) ──
	vinstall data/asusd.conf 644 usr/share/dbus-1/system.d

	# ── layouty klawiatur ──
	vmkdir usr/share/asusd
	if [ -d rog-aura/data/layouts ]; then
		vcopy rog-aura/data/layouts/* usr/share/asusd/
	fi

	# ── runit service zamiast systemd unit ──
	vinstall ${FILESDIR}/asusd/run 755 etc/sv/asusd
	vinstall ${FILESDIR}/asusd-log/run 755 etc/sv/asusd/log

	# ── autostart XDG zamiast "systemd --user" ──
	vinstall ${FILESDIR}/xdg-autostart/asusd-user.desktop 644 etc/xdg/autostart

	# ── plasmoid KDE (widget: profile/limit ładowania/klawiatura/Aura) ──
	# instalacja systemowa zamiast ~/.local/share — widoczny dla każdego
	# użytkownika bez ręcznego kopiowania; wymagania runtime opisuje
	# INSTALL.msg (xbps-src nie zna optdepends)
	vmkdir usr/share/plasma/plasmoids/org.voidlinux.plasma.asusctl
	vcopy ${FILESDIR}/plasmoid/org.voidlinux.plasma.asusctl/* \
		usr/share/plasma/plasmoids/org.voidlinux.plasma.asusctl/

	vlicense LICENSE
}
