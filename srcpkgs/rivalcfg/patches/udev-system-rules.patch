diff --git a/rivalcfg/debug.py b/rivalcfg/debug.py
index eb83b2b..83b14e5 100644
--- a/rivalcfg/debug.py
+++ b/rivalcfg/debug.py
@@ -41,8 +41,13 @@ def _get_rivalcfg_info():
     result = _make_title("Rivalcfg")
     result += "Version: %s\n" % VERSION
     if platform.system() == "Linux":
-        result += "udev rules installed: %a\n" % os.path.isfile(udev.RULES_FILE_PATH)
-        result += "udev rules up to date: %a\n" % udev.is_rules_file_up_to_date()
+        rules_files = [
+            path for path in udev.RULES_FILE_PATHS if os.path.isfile(path)
+        ]
+        result += "udev rules installed: %a\n" % bool(rules_files)
+        result += "udev rules up to date: %a\n" % any(
+            udev.is_rules_file_up_to_date(path) for path in rules_files
+        )
     result += "Installation path: %s\n" % os.path.dirname(__file__)
     return result
 
