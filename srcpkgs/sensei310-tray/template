# Template file for 'sensei310-tray'
pkgname=sensei310-tray
version=1.0.0
revision=14
build_style=cargo
hostmakedepends="pkg-config tar"
depends="kdialog rivalcfg"
short_desc="KDE tray controller for SteelSeries Sensei 310"
maintainer="Khame <khame.dev@protonmail.com>"
license="MIT"
homepage="https://github.com/khame/sensei310-tray"
distfiles=""
checksum=""

do_extract() {
	# Prepared on the host by packaging/void/prepare-local.py.
	# FILESDIR is available inside the xbps-src chroot.
	tar -xzf "${FILESDIR}/sensei310-tray-source.tar.gz" -C "${wrksrc}"
}

post_install() {
	vinstall packaging/sensei310-tray.desktop 644 usr/share/applications
	vinstall packaging/sensei310-tray.desktop 644 etc/xdg/autostart
	vlicense LICENSE
}
